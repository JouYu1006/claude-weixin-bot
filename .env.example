# DeepSeek API Key
LLM_API_KEY=sk-your-key-here

# API 端点
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型 — 最强: deepseek-v4-pro / 快速: deepseek-v4-flash
LLM_MODEL=deepseek-v4-pro

# 推理深度 (仅 v4-pro): low | medium | high
# high = 最强推理，但回答慢 / medium = 平衡 / low = 快速
LLM_REASONING=medium

# 温度: 0-1 (越高越有创意，越低越确定)
LLM_TEMPERATURE=0.7

# 最大输出 token 数 (V4-Pro 最多 384K，微信会自动分条)
LLM_MAX_TOKENS=8192

# 可选: 自定义 System Prompt
# SYSTEM_PROMPT=你是一个微信 AI 助手...
