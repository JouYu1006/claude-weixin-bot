# DeepSeek API Key
LLM_API_KEY=sk-your-key-here

# API 端点
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型 — 最强: deepseek-v4-pro / 快速: deepseek-v4-flash
LLM_MODEL=deepseek-v4-pro

# 推理深度 (仅 v4-pro): low | medium | high
LLM_REASONING=medium

# 温度: 0-1 / 最大输出 token 数 / 对话轮数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
CONVERSATION_ROUNDS=200

# 每日定时推送 (格式 HH:MM，不设则不推送)
DAILY_PUSH_TIME=08:00

# 可选: 自定义 System Prompt
# SYSTEM_PROMPT=你是一个微信 AI 助手...
