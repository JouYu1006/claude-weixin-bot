# Kimi (Moonshot AI) API Key — 去 https://platform.moonshot.cn 创建
LLM_API_KEY=sk-your-key-here

# API 端点
LLM_BASE_URL=https://api.moonshot.cn/v1

# 主模型 — kimi-k3（始终推理）
LLM_MODEL=kimi-k3

# 推理深度: low | high | max
LLM_REASONING=high

# 温度: 0-1 / 最大输出 token 数 / 对话轮数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=16384
CONVERSATION_ROUNDS=200

# 视觉模型（图片识别，支持图片/视频输入）
VISION_MODEL=kimi-k2.6

# 记忆抽取模型
MEMORY_MODEL=kimi-k2.6

# 每日定时推送 (格式 HH:MM，不设则不推送) / 推送查询天气的城市
DAILY_PUSH_TIME=08:00
PUSH_CITY=北京

# 可选: 自定义 System Prompt
# SYSTEM_PROMPT=你是一个微信 AI 助手...
